{
  // OpenCode config for this experiment.
  //
  // A config in the working directory OVERRIDES ~/.config/opencode/opencode.json
  // entirely for the servers it names — so edit THIS file, not your global one,
  // or the change will appear to do nothing.
  //
  // Start OpenCode from this directory: the command below is relative, and an
  // agent runs it against its own working directory.
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "obp": {
      "type": "local",
      // If `id` does not list dialout, either log out and back in (best), or
      // wrap this command:
      //   ["sg", "dialout", "-c", "python3 host/obp_mcp.py --log /tmp/obp-mcp.log"]
      // Changing it needs a full restart of OpenCode; it spawns the server once.
      "command": ["python3", "host/obp_mcp.py", "--log", "/tmp/obp-mcp.log"],
      "enabled": true,
      "cwd": "."
    }
  }
}
